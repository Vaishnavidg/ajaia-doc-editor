# PostgreSQL connection strings (Neon, Vercel Postgres, Supabase, or local Postgres).
#
# DATABASE_URL          - pooled connection, used by the app at runtime.
# DATABASE_URL_UNPOOLED - direct (unpooled) connection, used by `prisma migrate`
#                         / `db push`. Named to match what Vercel's Neon
#                         integration provisions automatically. If your
#                         provider has no separate direct URL, set this to the
#                         same value as DATABASE_URL.
#
# Neon example (note the "-pooler" host on DATABASE_URL only):
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"

# Optional: a separate throwaway database for `npm test` (its schema is reset and
# every row is deleted between tests). If unset, tests fall back to DATABASE_URL.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/DB_test?sslmode=require"
